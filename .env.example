CURRENTS_API_KEY=your_api_key_here

# Required for strategy creation/editing — the AI clarification step (clarification_service.py)
# is a hard gate; a strategy cannot be created or have its scope/pillars/weight-bar/gates
# edited without it. Everything else in the app runs fine without this key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — Index BTST Intelligence post-close run time (24h IST). Defaults to 15:45.
INDEX_INTELLIGENCE_RUN_HOUR=15
INDEX_INTELLIGENCE_RUN_MINUTE=45

# Optional — daily cap on real, billed Claude API calls from strategy clarification. Defaults to 20.
MAX_CLARIFICATIONS_PER_DAY=20
