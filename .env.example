# QuantHorizon Environment Configuration

# Required News API Key — CurrentsAPI (currentsapi.services)
CURRENTS_API_KEY=your_currents_api_key_here

# Required for strategy creation/editing — the AI clarification step (clarification_service.py)
# is a hard gate; a strategy cannot be created or have its scope/pillars/weight-bar/gates
# edited without it. Everything else in the app runs fine without this key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — Index BTST Intelligence post-close run time (24h IST). Defaults to 15:45.
INDEX_INTELLIGENCE_RUN_HOUR=15
INDEX_INTELLIGENCE_RUN_MINUTE=45

# Optional — daily cap on real, billed Claude API calls from strategy clarification. Defaults to 20.
MAX_CLARIFICATIONS_PER_DAY=20

# Optional — only needed if you're running the autonomous scanner on a persistent host (e.g.
# your own always-on machine, `python app.py`) AND separately deploying the dashboard/API to a
# stateless platform like Vercel that can't run that scheduler itself. Set this to the SAME
# Postgres connection string in both places (use the provider's POOLED connection string — Neon
# and Vercel Postgres both offer one, PgBouncer-backed) to share signal/strategy/trade state
# between them instead of each having its own local files/SQLite the other can't see. Unset (the
# default) keeps everything on local files/SQLite exactly as before — nothing here is required
# for a normal single-host run. See README's "Shared Postgres backend" section for the one-time
# migration step (scripts/migrate_to_postgres.py) if you're switching an existing installation.
DATABASE_URL=
