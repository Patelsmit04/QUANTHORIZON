# QuantHorizon Environment Configuration

# Required News API Key — CurrentsAPI (currentsapi.services)
CURRENTS_API_KEY=yEm55rVR1Ngrdsptj5t2k59WJvAooKh8y_VEpk4tz5hGP4EZ

# Zerodha Kite Connect API Credentials (Order Flow Veto Layer)
KITE_API_KEY=htmyh68hu099s2z9
KITE_API_SECRET=wwle5nc1d0lb95p621sgmzt15vzmsn4v
KITE_ACCESS_TOKEN=your_daily_access_token_here

# Optional — Index BTST Intelligence post-close run time (24h IST). Defaults to 15:45.
INDEX_INTELLIGENCE_RUN_HOUR=15
INDEX_INTELLIGENCE_RUN_MINUTE=45

# Optional — daily cap on real, billed Claude API calls from strategy clarification. Defaults to 20.
MAX_CLARIFICATIONS_PER_DAY=20

# Optional — Pillar 6: Institutional Flow (bulk/block deal) config. See block_deal_provider.py.
# Minimum same-day net deal value (Rs crore) to count as an institutional flow signal at all —
# SEBI's current block-deal floor (Oct 2025 circular, effective Dec 7 2025).
INSTITUTIONAL_FLOW_MIN_VALUE_CR=25
# Tier boundaries (Rs crore) above the minimum: WEAK < MODERATE < STRONG.
INSTITUTIONAL_FLOW_MODERATE_CR=50
INSTITUTIONAL_FLOW_STRONG_CR=150
# Checkpoint times (24h IST). live_trigger runs ~10 min after the confirmed 2:20 PM afternoon
# block-deal window close; final_check is the last live look before the 3:30 PM lock;
# eod_archive reconciles the live snapshot against NSE's official end-of-day file.
INSTITUTIONAL_FLOW_LIVE_TRIGGER_HOUR=14
INSTITUTIONAL_FLOW_LIVE_TRIGGER_MINUTE=30
INSTITUTIONAL_FLOW_FINAL_CHECK_HOUR=15
INSTITUTIONAL_FLOW_FINAL_CHECK_MINUTE=15
INSTITUTIONAL_FLOW_RECONCILE_HOUR=19
INSTITUTIONAL_FLOW_RECONCILE_MINUTE=30
# Shadow mode (default true): Pillar 6 is computed and visible in scan output but excluded from
# confirmed_pillars_weight / the live verdict until you've confirmed
# data/institutional_flow_reconciliation.json shows the live snapshot matching NSE's official
# EOD archive cleanly for a couple of weeks. Only set to false after that.
INSTITUTIONAL_FLOW_SHADOW_MODE=true
# Index-level aggregation (Nifty 50 / Bank Nifty only — Sensex has no NSE constituent-weight
# source). |net value Rs cr| below this reads as NEUTRAL rather than a call on a razor-thin sign.
INSTITUTIONAL_FLOW_INDEX_NEUTRAL_BAND_CR=10

# Optional — only needed if you're running the autonomous scanner on a persistent host (e.g.
# your own always-on machine, `python app.py`) AND separately deploying the dashboard/API to a
# stateless platform like Vercel that can't run that scheduler itself. Set this to the SAME
# Postgres connection string in both places (use the provider's POOLED connection string — Neon
# and Vercel Postgres both offer one, PgBouncer-backed) to share signal/strategy/trade state
# between them instead of each having its own local files/SQLite the other can't see. Unset (the
# default) keeps everything on local files/SQLite exactly as before — nothing here is required
# for a normal single-host run. See README's "Shared Postgres backend" section for the one-time
# migration step (scripts/migrate_to_postgres.py) if you're switching an existing installation.
DATABASE_URL=
